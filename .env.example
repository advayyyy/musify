# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local — it is already gitignored.

# MongoDB Atlas connection string.
# Get it from: https://cloud.mongodb.com -> your cluster -> Connect -> Drivers
# Add the database name (here "musify") before the "?" .
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/musify?retryWrites=true&w=majority"
